{
  "entities": {
    "AdminMember": {
      "title": "AdminMember",
      "description": "Elevated cloud administrator account authorized to manage workspace settings and staff access.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the administrator.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified administrator email address.",
          "maxLength": 254
        },
        "grantedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when admin access was granted."
        }
      },
      "required": ["uid", "email", "grantedAt"]
    },
    "Workspace": {
      "title": "Workspace",
      "description": "Root department workspace holding configuration and Google Drive root folder link for SOP documents.",
      "type": "object",
      "properties": {
        "workspaceId": {
          "type": "string",
          "description": "Unique workspace identifier.",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "description": "Firebase UID of workspace owner.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Department or hospital workspace display name.",
          "maxLength": 160
        },
        "googleDriveFolderId": {
          "type": "string",
          "description": "Google Drive folder ID where SOP and ISO document binaries remain stored.",
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp."
        }
      },
      "required": ["workspaceId", "ownerId", "name", "googleDriveFolderId", "createdAt", "updatedAt"]
    },
    "WorkspaceInvite": {
      "title": "WorkspaceInvite",
      "description": "Authorized staff email invitation enabling a colleague to join the department Firestore workspace.",
      "type": "object",
      "properties": {
        "inviteId": {
          "type": "string",
          "description": "Deterministic alphanumeric slug derived from email.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "workspaceId": {
          "type": "string",
          "description": "Parent workspace ID.",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "description": "UID of the admin who issued the invite.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Invited Google account email.",
          "maxLength": 254
        },
        "role": {
          "type": "string",
          "enum": ["Admin", "Manager", "Doctor", "Staff"],
          "description": "Assigned role in the department workspace."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when invite was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last updated server timestamp."
        }
      },
      "required": ["inviteId", "workspaceId", "ownerId", "email", "role", "createdAt", "updatedAt"]
    },
    "WorkspaceMember": {
      "title": "WorkspaceMember",
      "description": "Active member record granting verified Firestore read/write access to workspace collections.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Member Firebase Auth UID.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "workspaceId": {
          "type": "string",
          "description": "Parent workspace ID.",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "description": "Workspace owner UID or member UID.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "inviteId": {
          "type": "string",
          "description": "Invite document ID used for onboarding, or 'bootstrap-admin'.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified Google account email.",
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "description": "Display name of the staff member.",
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["Admin", "Manager", "Doctor", "Staff"],
          "description": "Role inside the workspace."
        },
        "status": {
          "type": "string",
          "enum": ["Active", "Revoked"],
          "description": "Current access state."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp."
        }
      },
      "required": ["uid", "workspaceId", "ownerId", "inviteId", "email", "displayName", "role", "status", "createdAt", "updatedAt"]
    },
    "DataBucket": {
      "title": "DataBucket",
      "description": "Structured Firestore bucket storing native arrays/objects for an operational module (tasks, equipment, staff, schedule, settings, Drive document metadata index).",
      "type": "object",
      "properties": {
        "bucketKey": {
          "type": "string",
          "description": "Operational module key identifier.",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "workspaceId": {
          "type": "string",
          "description": "Parent workspace ID.",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "description": "UID of initial creator.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "items": {
          "type": "array",
          "description": "Native list of operational records (for Drive documents, only metadata and Google Drive URL/IDs are stored here)."
        },
        "itemCount": {
          "type": "number",
          "description": "Number of items in the bucket."
        },
        "updatedByUid": {
          "type": "string",
          "description": "Firebase UID of the last editor.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedByName": {
          "type": "string",
          "description": "Display name of the last editor.",
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Initial sync server timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Latest sync server timestamp."
        }
      },
      "required": ["bucketKey", "workspaceId", "ownerId", "items", "itemCount", "updatedByUid", "updatedByName", "createdAt", "updatedAt"]
    },
    "ReportArchiveMonth": {
      "title": "ReportArchiveMonth",
      "description": "Immutable monthly archive of daily case statistics scoped by year and month.",
      "type": "object",
      "properties": {
        "archiveKey": {
          "type": "string",
          "description": "Year-month archive ID e.g. 2026_m02.",
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "workspaceId": {
          "type": "string",
          "description": "Parent workspace ID.",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "description": "UID of initial creator.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "year": {
          "type": "number",
          "description": "Calendar year of the report archive."
        },
        "monthKey": {
          "type": "string",
          "description": "Vietnamese month label e.g. Tháng 2.",
          "maxLength": 24
        },
        "items": {
          "type": "array",
          "description": "Native list of ArchivedCaseReportItem entries with dailyData and manualDays locks."
        },
        "updatedByUid": {
          "type": "string",
          "description": "Firebase UID of the last updater.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedByName": {
          "type": "string",
          "description": "Display name of the last updater.",
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp."
        }
      },
      "required": ["archiveKey", "workspaceId", "ownerId", "year", "monthKey", "items", "updatedByUid", "updatedByName", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/admins/{userId}": {
      "schema": {
        "$ref": "#/entities/AdminMember"
      },
      "description": "Authorized cloud admin accounts."
    },
    "/workspaces/{workspaceId}": {
      "schema": {
        "$ref": "#/entities/Workspace"
      },
      "description": "Root department workspace metadata including Google Drive Folder ID."
    },
    "/workspaces/{workspaceId}/invites/{inviteId}": {
      "schema": {
        "$ref": "#/entities/WorkspaceInvite"
      },
      "description": "Admin-issued staff invitations for joining the department cloud database."
    },
    "/workspaces/{workspaceId}/members/{memberId}": {
      "schema": {
        "$ref": "#/entities/WorkspaceMember"
      },
      "description": "Active members authorized to read/write department data."
    },
    "/workspaces/{workspaceId}/buckets/{bucketKey}": {
      "schema": {
        "$ref": "#/entities/DataBucket"
      },
      "description": "Operational data buckets (tasks, equipment, staff, schedule, rooms, settings, Drive document index)."
    },
    "/workspaces/{workspaceId}/report_archives/{archiveKey}": {
      "schema": {
        "$ref": "#/entities/ReportArchiveMonth"
      },
      "description": "Year-scoped immutable monthly archives of daily clinical case counts."
    }
  }
}
