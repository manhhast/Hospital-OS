    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "eslint": "^10.15.0",
    "express": "^5.3.0",
    "firebase": "^13.3.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "read-excel-file": "^9.3.20",
    "recharts": "^3.10.1",
